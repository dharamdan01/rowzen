# Development placeholders: never commit real credentials.
DATABASE_URL=""
DIRECT_URL=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# OAuth secrets stay server-side. Keep the same BETTER_AUTH_SECRET for existing sessions.
# Production BETTER_AUTH_URL: https://rowzen.vercel.app (origin only, no /api/auth).
# Google requires BOTH variables below in Vercel's Production environment, then a redeploy.
# Google Web client redirect URI: https://rowzen.vercel.app/api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Default is local Ollama; never put hosted credentials in NEXT_PUBLIC_* variables.
# Hosted inference requires a reviewed metadata-only server endpoint and explicit user consent.
NEXT_PUBLIC_AI_PROVIDER="ollama"
AI_HOSTED_ENABLED="false"
GROQ_API_KEY=your_groq_api_key_here
# Shared production request budgets (Upstash Redis REST, separate Preview/Production stores).
AI_RATE_LIMIT_REDIS_REST_URL=""
AI_RATE_LIMIT_REDIS_REST_TOKEN=""
